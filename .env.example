APP_NAME=ABVHPS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# AWS RDS MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=abvhps_prod
DB_USERNAME=abvhps_dbuser
DB_PASSWORD=

# Session Management (HTTPS enforced for production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache and Queue Architecture (AWS Production)
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# AWS S3 Cloud Storage Configuration (Supports IAM Role on EC2/ECS)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=your-abvhps-storage-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=https://your-cloudfront-distribution.cloudfront.net

# AWS SES / SMTP Email Configuration
MAIL_MAILER=ses
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@abvhps.org"
MAIL_FROM_NAME="ABVHPS"

# Fast2SMS Gateway Configuration
FAST2SMS_API_KEY=
FAST2SMS_ENTITY_ID=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# Cashfree Payment Gateway
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=production

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=live

# Frontend Vite
VITE_APP_NAME="${APP_NAME}"

# Mobile API Sanctum Expiration (129600 minutes = 90 days)
SANCTUM_EXPIRATION_MINUTES=129600

# Reverb WebSocket Broadcasting (local development only)
# REVERB_SERVER_HOST: interface Reverb server binds to (0.0.0.0 = all interfaces)
# REVERB_HOST:        host that pusher-php and clients use to CONNECT to Reverb
# WARNING: Never set REVERB_HOST=0.0.0.0 in production — always use a real hostname/IP.
# Production: BROADCAST_CONNECTION should remain 'log' until Reverb is provisioned on the server.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
